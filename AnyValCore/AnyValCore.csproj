<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>Gixabel</Authors>
    <Company>Maia Sistemas</Company>
    <Product>AnyValue</Product>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Library with random values in different types</Description>
    <PackageTags>testing value types</PackageTags>
    <PackageIcon>AnyValCore.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/gixabel/AnyValCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Added PositiveInt32GreaterThanZero and DecimalGreaterThanZero. Random generation is now thread-safe.</PackageReleaseNotes>
    <Version>9.1.0</Version>
    <AssemblyVersion>9.1.0.0</AssemblyVersion>
    <FileVersion>9.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\AnyValCore.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
